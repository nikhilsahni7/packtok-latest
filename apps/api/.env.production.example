# Packtok API production environment template.
# Copy this file to apps/api/.env.production for local Compose testing.
# On the VPS, create /opt/packtok/apps/api/.env.production with the same values.

# Runtime
NODE_ENV=production
PORT=3001
CORS_ORIGIN=⚠️ USER ACTION REQUIRED: comma-separated allowed frontend origins, for example https://packtok.example.com,https://admin.packtok.example.com
COOKIE_DOMAIN=⚠️ USER ACTION REQUIRED: cookie parent domain, for example .yourdomain.com
JWT_SECRET=⚠️ USER ACTION REQUIRED: strong random JWT signing secret used by the API

# PostgreSQL
DATABASE_URL=⚠️ USER ACTION REQUIRED: managed PostgreSQL connection string, for example postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Supabase Auth and Storage
SUPABASE_URL=⚠️ USER ACTION REQUIRED: Supabase project URL
SUPABASE_SERVICE_ROLE_KEY=⚠️ USER ACTION REQUIRED: Supabase service role key
SUPABASE_JWT_SECRET=⚠️ USER ACTION REQUIRED: Supabase JWT secret
SUPABASE_IMAGE_BUCKET=⚠️ USER ACTION REQUIRED: Supabase image bucket name
SUPABASE_VIDEO_BUCKET=⚠️ USER ACTION REQUIRED: Supabase video bucket name
SUPABASE_DOC_BUCKET=⚠️ USER ACTION REQUIRED: Supabase document bucket name
SUPABASE_BUCKET_PRIVATE=true

# Resend Email and OTP
RESEND_API_KEY=⚠️ USER ACTION REQUIRED: Resend API key
RESEND_FROM_EMAIL=⚠️ USER ACTION REQUIRED: verified sender email, for example Packtok <noreply@yourdomain.com>

# Razorpay Payments
RAZORPAY_KEY_ID=⚠️ USER ACTION REQUIRED: Razorpay key ID
RAZORPAY_KEY_SECRET=⚠️ USER ACTION REQUIRED: Razorpay key secret

# S3-compatible Podcast Video Storage
AWS_ACCESS_KEY_ID=⚠️ USER ACTION REQUIRED: S3 access key ID
AWS_SECRET_ACCESS_KEY=⚠️ USER ACTION REQUIRED: S3 secret access key
AWS_REGION=⚠️ USER ACTION REQUIRED: S3 region, for example ap-south-1
AWS_PODCAST_BUCKET=⚠️ USER ACTION REQUIRED: podcast video bucket name
AWS_PODCAST_PUBLIC_BASE_URL=⚠️ USER ACTION REQUIRED: public base URL for podcast objects, if applicable
AWS_S3_ENDPOINT=⚠️ USER ACTION REQUIRED: S3-compatible endpoint URL, leave empty for AWS S3
AWS_S3_FORCE_PATH_STYLE=false
AWS_PODCAST_SIGNED_URL_EXPIRES_SECONDS=3600
PODCAST_UPLOAD_CONCURRENCY=3
