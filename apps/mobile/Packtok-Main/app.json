{
  "expo": {
    "name": "Packtok",
    "slug": "Packtok-Main",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mobile-logo.png",
    "scheme": "packtokmain",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.packtok.app",
      "icon": "./assets/images/mobile-logo.png"
    },
    "android": {
      "icon": "./assets/images/mobile-logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/mobile-logo.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.packtok.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": ["expo-router", "expo-video", "expo-font"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "60f0784e-7564-4f60-a24c-3c8af1af98df"
      }
    }
  }
}
