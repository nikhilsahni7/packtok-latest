# Packtok web (Next.js) environment.
# In Vercel: Project → Settings → Environment Variables, then REDEPLOY —
# NEXT_PUBLIC_* values are inlined at build time, old builds keep old values.

# Browser-exposed API origin. This is a public URL, NOT a secret; client
# components, axios, and Socket.IO need it to call the API from the browser.
NEXT_PUBLIC_API_BASE_URL=https://api.packtok.com

# Server-only API origin (Server Components / server-side auth). Same value,
# but never shipped to the browser because it lacks the NEXT_PUBLIC_ prefix.
API_BASE_URL=https://api.packtok.com
