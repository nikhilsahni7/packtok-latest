# Database
DATABASE_URL="postgresql://username:password@localhost:5432/packtok"

# JWT Secret
JWT_SECRET="your-jwt-secret-key-here"

# API Configuration
API_PORT=3001
API_HOST=localhost

# Frontend URLs
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"

# NextAuth (for admin)
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3002"



# Third-party services (add as needed)
# STRIPE_SECRET_KEY=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_PODCAST_BUCKET=""
# Signed playback URL expiry in seconds
# AWS_PODCAST_SIGNED_URL_EXPIRES_SECONDS="3600"
# Optional custom public URL/domain for podcast videos
# AWS_PODCAST_PUBLIC_BASE_URL=""
# Optional S3-compatible endpoint (Cloudflare R2/MinIO/etc.)
# AWS_S3_ENDPOINT=""
# Set true for path-style URLs on S3-compatible providers
# AWS_S3_FORCE_PATH_STYLE="false"
# REDIS_URL=""
# EMAIL_SERVICE_API_KEY=""
